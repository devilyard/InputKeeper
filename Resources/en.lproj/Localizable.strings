"help.title" = "InputKeeper Help";
"help.how_it_works.title" = "How It Works";
"help.how_it_works.body" = "InputKeeper remembers the last input method used in each app. Select the input method you want while an app is active; the next time you return to that app, InputKeeper restores it automatically.";
"help.controls.title" = "Menu Bar Controls";
"help.controls.body" = "Use the InputKeeper menu to pause automatic switching, inspect remembered apps, forget one setting, or remove all remembered settings.";
"help.permissions.title" = "Permissions";
"help.permissions.body" = "InputKeeper does not read typed text and does not require Accessibility or Input Monitoring permission. It uses macOS input-source APIs and stores preferences only in its sandbox container.";

"support.title" = "InputKeeper Support";
"support.troubleshooting.title" = "Troubleshooting";
"support.troubleshooting.body" = "Make sure automatic switching is enabled, activate the affected app, and select the desired input method once. If an old setting is incorrect, forget that app’s setting and select the input method again.";
"support.diagnostics.title" = "Information to Include";
"support.diagnostics.body" = "When reporting a problem, include your macOS version, the affected app names, the input method names, and the exact order in which you switched apps. Never include typed text or private document content.";
"support.contact.title" = "Contact";
"support.contact.body" = "Use the support URL on InputKeeper’s App Store product page to contact the developer and check current support information.";

"privacy.title" = "Privacy Policy";
"privacy.updated" = "Last updated: November 4, 2026";
"privacy.local_data.title" = "Data Stored on This Mac";
"privacy.local_data.body" = "InputKeeper stores an app’s bundle identifier and name, the selected input method’s identifier and name, and whether automatic switching is enabled. These preferences remain inside InputKeeper’s sandbox container.";
"privacy.no_collection.title" = "No Collection or Sharing";
"privacy.no_collection.body" = "InputKeeper does not read keystrokes or document content. It does not transmit data, track users, display advertising, include analytics, or share information with third parties.";
"privacy.retention.title" = "Retention and Deletion";
"privacy.retention.body" = "Preferences remain until you forget an individual setting, choose Forget All Settings, or remove InputKeeper’s sandbox data. InputKeeper has no account or remote copy of this information.";
"privacy.support.title" = "Questions";
"privacy.support.body" = "For privacy questions or support, choose Technical Support from the InputKeeper menu.";

